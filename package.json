{
  "name": "frontier-watch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "fetch": "tsx scripts/fetch-all.ts",
    "build:data": "tsx scripts/build-data.ts",
    "build:refs": "tsx scripts/build-references.ts",
    "refresh": "npm run fetch && npm run build:data",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "postbuild:data": "tsx scripts/build-references.ts"
  },
  "dependencies": {
